{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasumi.dev/schema/commands.schema.json",
  "title": "Kasumi command contract",
  "type": "object",
  "required": ["commands", "events"],
  "properties": {
    "commands": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/command"
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["windows", "android"]
      }
    },
    "valueSchema": {
      "type": "object",
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "object",
                "array",
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/valueSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1
        },
        "const": {},
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "objectSchema": {
      "type": "object",
      "required": ["type", "properties", "required", "additionalProperties"],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "args",
        "result",
        "permissions",
        "platforms",
        "since"
      ],
      "properties": {
        "args": {
          "$ref": "#/$defs/objectSchema"
        },
        "result": {
          "$ref": "#/$defs/objectSchema"
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "$ref": "#/$defs/platforms"
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["payload", "platforms", "since"],
      "properties": {
        "payload": {
          "$ref": "#/$defs/objectSchema"
        },
        "platforms": {
          "$ref": "#/$defs/platforms"
        },
        "since": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
