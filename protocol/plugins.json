{
  "plugins": {
    "core": {
      "name": "Core",
      "version": "1.0.0",
      "description": "Application lifecycle, permissions, events and capability discovery.",
      "frontendPackage": "kasumi-bridge",
      "platforms": ["windows", "android"],
      "permissions": ["window.control"],
      "defaultPermissions": ["window.control"],
      "commands": [
        "ping",
        "capabilities.query",
        "app.getInfo",
        "app.exit",
        "permission.request",
        "event.subscribe",
        "event.unsubscribe"
      ]
    },
    "fs": {
      "name": "Filesystem",
      "version": "1.0.0",
      "description": "Sandboxed virtual filesystem access.",
      "frontendPackage": "kasumi-plugin-fs",
      "platforms": ["windows", "android"],
      "permissions": ["fs.read", "fs.write", "fs.remove"],
      "defaultPermissions": ["fs.read", "fs.write", "fs.remove"],
      "commands": [
        "fs.readText",
        "fs.writeText",
        "fs.appendText",
        "fs.copy",
        "fs.move",
        "fs.readBytes",
        "fs.writeBytes",
        "fs.exists",
        "fs.remove",
        "fs.readDir",
        "fs.mkdir",
        "fs.stat"
      ]
    },
    "dialog": {
      "name": "Dialog",
      "version": "1.0.0",
      "description": "Native message, confirmation and file picker dialogs.",
      "frontendPackage": "kasumi-plugin-dialog",
      "platforms": ["windows", "android"],
      "permissions": ["dialog"],
      "defaultPermissions": ["dialog"],
      "commands": [
        "dialog.message",
        "dialog.confirm",
        "dialog.openFile",
        "dialog.saveFile"
      ]
    },
    "clipboard": {
      "name": "Clipboard",
      "version": "1.0.0",
      "description": "System clipboard text access.",
      "frontendPackage": "kasumi-plugin-clipboard",
      "platforms": ["windows", "android"],
      "permissions": ["clipboard.read", "clipboard.write"],
      "defaultPermissions": ["clipboard.read", "clipboard.write"],
      "commands": [
        "clipboard.readText",
        "clipboard.writeText"
      ]
    },
    "notification": {
      "name": "Notification",
      "version": "1.0.0",
      "description": "Native system notifications.",
      "frontendPackage": "kasumi-plugin-notification",
      "platforms": ["windows", "android"],
      "permissions": ["notification.show"],
      "defaultPermissions": ["notification.show"],
      "commands": [
        "notification.show"
      ]
    },
    "window": {
      "name": "Window",
      "version": "1.0.0",
      "description": "Window title, size, lifecycle and application exit controls.",
      "frontendPackage": "kasumi-plugin-window",
      "platforms": ["windows", "android"],
      "permissions": ["window.control"],
      "defaultPermissions": ["window.control"],
      "commands": [
        "window.setTitle",
        "window.minimize",
        "window.maximize",
        "window.setSize",
        "window.close"
      ]
    },
    "http": {
      "name": "HTTP",
      "version": "1.0.0",
      "description": "HTTPS downloads into the virtual filesystem.",
      "frontendPackage": "kasumi-plugin-http",
      "platforms": ["windows", "android"],
      "permissions": ["http.download"],
      "defaultPermissions": ["http.download"],
      "commands": [
        "http.download"
      ]
    },
    "shell": {
      "name": "Shell",
      "version": "1.4.0",
      "description": "Allowlisted external URL launching.",
      "frontendPackage": "kasumi-plugin-shell",
      "platforms": ["windows", "android"],
      "permissions": ["shell.open"],
      "defaultPermissions": ["shell.open"],
      "commands": [
        "shell.openExternal",
        "shell.openPath",
        "shell.showInFolder"
      ]
    },
    "device": {
      "name": "Device",
      "version": "1.0.0",
      "description": "Non-identifying Android device information.",
      "frontendPackage": "kasumi-plugin-device",
      "platforms": ["android"],
      "permissions": ["device.info"],
      "defaultPermissions": ["device.info"],
      "commands": [
        "device.getInfo"
      ]
    },
    "sql": {
      "name": "SQL",
      "version": "1.2.0",
      "description": "Database connections and parameterised SQL statements.",
      "frontendPackage": "kasumi-plugin-sql",
      "platforms": ["windows", "android"],
      "permissions": ["sql"],
      "defaultPermissions": ["sql"],
      "commands": [
        "sql.drivers",
        "sql.open",
        "sql.query",
        "sql.execute",
        "sql.close"
      ]
    },
    "path": {
      "name": "Path",
      "version": "1.3.0",
      "description": "Virtual application path inspection and construction.",
      "frontendPackage": "kasumi-plugin-path",
      "platforms": ["windows", "android"],
      "permissions": [],
      "defaultPermissions": [],
      "commands": [
        "path.dirs",
        "path.join",
        "path.normalize",
        "path.dirname",
        "path.basename",
        "path.extname",
        "path.isAbsolute"
      ]
    },
    "store": {
      "name": "Store",
      "version": "1.3.0",
      "description": "Persistent JSON key-value storage inside application data.",
      "frontendPackage": "kasumi-plugin-store",
      "platforms": ["windows", "android"],
      "permissions": ["store"],
      "defaultPermissions": ["store"],
      "commands": [
        "store.get",
        "store.set",
        "store.delete",
        "store.clear",
        "store.keys"
      ]
    },
    "os": {
      "name": "OS",
      "version": "1.3.0",
      "description": "Non-identifying operating system and runtime information.",
      "frontendPackage": "kasumi-plugin-os",
      "platforms": ["windows", "android"],
      "permissions": ["os.info"],
      "defaultPermissions": ["os.info"],
      "commands": [
        "os.getInfo"
      ]
    },
    "log": {
      "name": "Log",
      "version": "1.3.0",
      "description": "Platform logger access with bounded messages.",
      "frontendPackage": "kasumi-plugin-log",
      "platforms": ["windows", "android"],
      "permissions": ["log.write"],
      "defaultPermissions": ["log.write"],
      "commands": [
        "log.write"
      ]
    },
    "appInstance": {
      "name": "App Instance",
      "version": "1.4.0",
      "description": "Single instance state and focus coordination.",
      "frontendPackage": "kasumi-bridge",
      "platforms": ["windows", "android"],
      "permissions": [],
      "defaultPermissions": [],
      "commands": [
        "app.singleInstance.state",
        "app.singleInstance.focus"
      ]
    },
    "updater": {
      "name": "Updater",
      "version": "1.4.0",
      "description": "Check and download application update packages.",
      "frontendPackage": "kasumi-plugin-updater",
      "platforms": ["windows", "android"],
      "permissions": ["updater"],
      "defaultPermissions": ["updater"],
      "commands": [
        "updater.check",
        "updater.download"
      ]
    },
    "globalShortcut": {
      "name": "Global Shortcut",
      "version": "1.4.0",
      "description": "Register and unregister global keyboard shortcuts.",
      "frontendPackage": "kasumi-plugin-global-shortcut",
      "platforms": ["windows"],
      "permissions": ["globalShortcut"],
      "defaultPermissions": ["globalShortcut"],
      "commands": [
        "globalShortcut.register",
        "globalShortcut.unregister"
      ]
    },
    "tray": {
      "name": "Tray",
      "version": "1.4.0",
      "description": "Show and hide the system tray icon.",
      "frontendPackage": "kasumi-plugin-tray",
      "platforms": ["windows"],
      "permissions": ["tray"],
      "defaultPermissions": ["tray"],
      "commands": [
        "tray.show",
        "tray.hide"
      ]
    }
  }
}
