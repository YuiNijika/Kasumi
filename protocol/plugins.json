        "windows",
        "android"
      ],
      "permissions": [
        "app.deepLink",
        "app.devtools",
        "window.control"
      ],
      "defaultPermissions": [
        "app.deepLink",
        "app.devtools",
        "window.control"
      ],
      "commands": [
        "ping",
        "capabilities.query",
