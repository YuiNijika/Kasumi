{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasumi.miomoe.cn/schemas/kasumi.config.schema.json",
  "title": "Kasumi application configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "windows",
    "android"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
          }
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
          }
        }
      }
    }
  }
}
