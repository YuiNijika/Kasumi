{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasumi.miomoe.cn/schemas/kasumi.config.schema.json",
  "title": "Kasumi application configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "windows",
    "android"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "description": "Reverse-domain application identifier shared across platforms."
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "type": "string",
          "minLength": 1
        },
        "tray": {
          "type": "string",
          "minLength": 1
        },
        "installer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certificate": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowsInstaller": {
          "enum": [
            "nsis",
            "msi"
          ]
        }
      }
    },
 "extensions": {
 "type": "array",
 "uniqueItems": true,
 "items": {
 "type": "object",
 "additionalProperties": false,
 "required": ["id", "manifest", "platforms"],
 "properties": {
 "id": {
 "type": "string",
 "pattern": "^[a-z0-9][a-z0-9-]*$"
 },
 "manifest": {
 "type": "string",
 "minLength":1,
 "pattern": "^(?!/)(?!.*\\.\\.).+\\.json$"
 },
 "platforms": {
 "type": "array",
 "minItems":1,
 "uniqueItems": true,
 "items": {
 "enum": ["windows", "android"]
 }
 }
 }
 }
 },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "description": "Use all to enable the complete Windows command matrix, or list an explicit allowlist.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "permissions": {
          "description": "Use all to grant every known permission, or list an explicit allowlist. Omit or use an empty array to deny all permissions.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "decorations": {
          "type": "boolean",
          "default": true,
          "description": "Show the native Windows title bar. Set to false to provide custom window controls."
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "decorations": {
              "type": "boolean"
            },
            "transparent": {
              "type": "boolean"
            },
            "alwaysOnTop": {
              "type": "boolean"
            },
            "center": {
              "type": "boolean"
            },
            "width": {
              "type": "integer",
              "minimum": 0
            },
            "height": {
              "type": "integer",
              "minimum": 0
            },
            "minWidth": {
              "type": "integer",
              "minimum": 0
            },
            "minHeight": {
              "type": "integer",
              "minimum": 0
            },
            "maxWidth": {
              "type": "integer",
              "minimum": 0
            },
            "maxHeight": {
              "type": "integer",
              "minimum": 0
            },
            "resizable": {
              "type": "boolean"
            },
            "visible": {
              "type": "boolean"
            }
          }
        },
        "tray": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": {
              "type": "string"
            },
            "tooltip": {
              "type": "string"
            },
            "menu": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "action"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                }
              }
            },
            "clickAction": {
              "type": "string"
            }
          }
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "description": "Use all to enable the complete Android command matrix, or list an explicit allowlist.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "permissions": {
          "description": "Use all to grant every known permission, or list an explicit allowlist. Omit or use an empty array to deny all permissions.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "webview": {
          "type": "object",
          "additionalProperties": false,
          "description": "Android WebView entry URLs and accepted HTML files.",
          "properties": {
            "productionEntry": {
              "type": "string",
              "pattern": "^https://app\\.local/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.html$"
            },
            "developmentEntries": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^http://localhost:5173(?:/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.html|/)?$"
              }
            },
            "supportedHtmlFiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+\\.html$"
              }
            }
          }
        }
      }
    }
  }
}
