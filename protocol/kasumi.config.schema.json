{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kasumi.miomoe.cn/schemas/kasumi.config.schema.json",
  "title": "Kasumi application configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "windows",
    "android"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "description": "Use all to enable the complete Windows command matrix, or list an explicit allowlist.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "permissions": {
          "description": "Use all to grant every known permission, or list an explicit allowlist. Omit or use an empty array to deny all permissions.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "decorations": {
          "type": "boolean",
          "default": true,
          "description": "Show the native Windows title bar. Set to false to provide custom window controls."
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        }
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "version",
        "commands"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commands": {
          "description": "Use all to enable the complete Android command matrix, or list an explicit allowlist.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "permissions": {
          "description": "Use all to grant every known permission, or list an explicit allowlist. Omit or use an empty array to deny all permissions.",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
              }
            }
          ]
        },
        "shell": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?$"
              }
            }
          }
        }
      }
    }
  }
}
