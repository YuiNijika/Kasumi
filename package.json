{
  "name": "kasumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "ksm": "node cli/ksm.mjs",
    "dev": "pnpm ksm dev",
    "dev:windows": "pnpm ksm dev --windows",
    "dev:android": "pnpm ksm dev --android",
    "build": "pnpm ksm build",
    "build:windows": "pnpm ksm build --windows",
    "build:android": "pnpm ksm build --android",
    "build:all": "pnpm ksm build --all",
    "test": "pnpm ksm test --all --target sdk",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test:contract": "tsx tests/contract/run.ts",
    "validate:protocol": "pnpm ksm validate",
    "codegen": "pnpm ksm codegen"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
