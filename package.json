{
  "name": "kasumi",
  "version": "26.11.2-alpha.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "ksm": "node cli/ksm.mjs",
    "dev": "pnpm ksm dev",
    "dev:windows": "pnpm ksm dev --windows",
    "dev:android": "pnpm ksm dev --android",
    "build": "pnpm ksm build",
    "build:windows": "pnpm ksm build --windows",
    "build:android": "pnpm ksm build --android",
    "build:all": "pnpm ksm build --all",
    "release:prepare": "pnpm ksm package --all --target all",
    "test": "pnpm ksm test --all --target sdk",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test:contract": "tsx tests/contract/run.ts",
    "test:packages": "node --test packages/create-kasumi/tests/*.test.mjs packages/kasumi-cli/tests/*.test.mjs",
    "test:tarballs": "node tools/test-npm-packages.mjs",
    "version:show": "node cli/ksm.mjs version show",
    "version:sync": "node cli/ksm.mjs version sync",
    "version:check": "node cli/ksm.mjs version check",
    "build:bridge": "pnpm --filter kasumi-bridge build",
    "pack:packages": "pnpm build:bridge && pnpm --filter kasumi-cli pack && pnpm --filter kasumi-bridge pack && pnpm --filter create-kasumi pack",
    "validate:protocol": "pnpm ksm validate",
    "codegen": "pnpm ksm codegen"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
