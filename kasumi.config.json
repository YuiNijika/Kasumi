{
  "$schema": "./protocol/kasumi.config.schema.json",
  "windows": {
    "packageName": "kasumi-win32-example",
    "version": "26.11.12",
    "commands": "all",
    "permissions": "all",
    "decorations": true,
    "shell": {
      "allowedOrigins": [
        "https://example.com"
      ]
    },
    "http": {
      "allowedOrigins": [
        "https://example.com"
      ]
    }
  },
  "android": {
    "packageName": "dev.kasumi.example",
    "version": "26.11.12",
    "commands": "all",
    "permissions": "all",
    "shell": {
      "allowedOrigins": [
        "https://example.com"
      ]
    },
    "http": {
      "allowedOrigins": [
        "https://example.com"
      ]
    },
    "webview": {
      "productionEntry": "https://app.local/index.html",
      "developmentEntries": [
        "http://localhost:5173/index.html",
        "http://localhost:5173/",
        "http://localhost:5173"
      ],
      "supportedHtmlFiles": [
        "index.html"
      ]
    }
  }
}
