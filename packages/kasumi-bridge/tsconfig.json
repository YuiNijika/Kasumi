{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "../../frontend/src",
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "../../frontend/src/**/*.ts"
  ]
}
