{
  "name": "kasumi-bridge",
  "version": "26.11.2-alpha.4",
  "description": "TypeScript frontend bridge for Kasumi applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dialog": {
      "types": "./dist/api/dialog.d.ts",
      "import": "./dist/api/dialog.js"
    },
    "./fs": {
      "types": "./dist/api/fs.d.ts",
      "import": "./dist/api/fs.js"
    },
    "./sql": {
      "types": "./dist/api/sql.d.ts",
      "import": "./dist/api/sql.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuiNijika/Kasumi.git"
  },
  "homepage": "https://blog.miomoe.cn/docs/kasumi"
}
