{
  "name": "kasumi-bridge",
  "version": "26.11.7",
  "description": "TypeScript frontend bridge for Kasumi applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dialog": {
      "types": "./dist/api/dialog.d.ts",
      "import": "./dist/api/dialog.js"
    },
    "./clipboard": {
      "types": "./dist/api/clipboard.d.ts",
      "import": "./dist/api/clipboard.js"
    },
    "./device": {
      "types": "./dist/api/device.d.ts",
      "import": "./dist/api/device.js"
    },
    "./fs": {
      "types": "./dist/api/fs.d.ts",
      "import": "./dist/api/fs.js"
    },
    "./http": {
      "types": "./dist/api/http.d.ts",
      "import": "./dist/api/http.js"
    },
    "./log": {
      "types": "./dist/api/log.d.ts",
      "import": "./dist/api/log.js"
    },
    "./notification": {
      "types": "./dist/api/notification.d.ts",
      "import": "./dist/api/notification.js"
    },
    "./os": {
      "types": "./dist/api/os.d.ts",
      "import": "./dist/api/os.js"
    },
    "./path": {
      "types": "./dist/api/path.d.ts",
      "import": "./dist/api/path.js"
    },
    "./shell": {
      "types": "./dist/api/shell.d.ts",
      "import": "./dist/api/shell.js"
    },
    "./sql": {
      "types": "./dist/api/sql.d.ts",
      "import": "./dist/api/sql.js"
    },
    "./store": {
      "types": "./dist/api/store.d.ts",
      "import": "./dist/api/store.js"
    },
    "./window": {
      "types": "./dist/api/window.d.ts",
      "import": "./dist/api/window.js"
    },
    "./appInstance": {
      "types": "./dist/api/appInstance.d.ts",
      "import": "./dist/api/appInstance.js"
    },
    "./audio": {
      "types": "./dist/api/audio.d.ts",
      "import": "./dist/api/audio.js"
    },
    "./deepLinks": {
      "types": "./dist/api/deepLinks.d.ts",
      "import": "./dist/api/deepLinks.js"
    },
    "./devtools": {
      "types": "./dist/api/devtools.d.ts",
      "import": "./dist/api/devtools.js"
    },
    "./media": {
      "types": "./dist/api/media.d.ts",
      "import": "./dist/api/media.js"
    },
    "./mediaSession": {
      "types": "./dist/api/mediaSession.d.ts",
      "import": "./dist/api/mediaSession.js"
    },
    "./updater": {
      "types": "./dist/api/updater.d.ts",
      "import": "./dist/api/updater.js"
    },
    "./globalShortcut": {
      "types": "./dist/api/globalShortcut.d.ts",
      "import": "./dist/api/globalShortcut.js"
    },
    "./tray": {
      "types": "./dist/api/tray.d.ts",
      "import": "./dist/api/tray.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuiNijika/Kasumi.git"
  },
  "homepage": "https://blog.miomoe.cn/docs/kasumi"
}
