{
  "$schema": "https://raw.githubusercontent.com/YuiNijika/Kasumi/main/protocol/kasumi.config.schema.json",
  "windows": {
    "packageName": "__WINDOWS_PACKAGE_NAME__",
    "version": "__KASUMI_VERSION__",
    "commands": [
      "ping",
      "capabilities.query",
      "app.getInfo",
      "event.subscribe",
      "event.unsubscribe",
      "app.exit"
    ],
    "permissions": [],
    "decorations": true
  },
  "android": {
    "packageName": "__ANDROID_PACKAGE_NAME__",
    "version": "__KASUMI_VERSION__",
    "commands": [
      "ping",
      "capabilities.query",
      "app.getInfo",
      "event.subscribe",
      "event.unsubscribe",
      "app.exit"
    ],
    "permissions": [],
    "webview": {
      "productionEntry": "https://app.local/index.html",
      "developmentEntries": [
        "http://localhost:5173/index.html",
        "http://localhost:5173/",
        "http://localhost:5173"
      ],
      "supportedHtmlFiles": [
        "index.html"
      ]
    }
  }
}
